# =====================================================
# .env.example — Template konfigurasi (AMAN untuk di-commit)
# =====================================================
# CARA PAKAI:
# 1. Copy file ini: cp .env.example .env
# 2. Isi nilai yang sebenarnya di .env
# 3. JANGAN PERNAH commit file .env ke Git!
# =====================================================

# ---- Database (Aiven Cloud) ----
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=

# ---- Server ----
PORT=

# ---- JWT (ganti dengan string panjang acak, min 32 karakter!) ----
# Cara generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- Environment ----
NODE_ENV=

# ---- CORS (pisahkan dengan koma, tanpa spasi) ----
ALLOWED_ORIGINS=

# ---- Notifikasi (opsional) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# =====================================================
# MIDTRANS - SANDBOX ✅
# =====================================================
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=
